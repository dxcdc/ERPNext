# Ambiente da aplicação
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# Banco de dados (ERPNext/Frappe MariaDB)
DB_HOST=db
DB_PORT=3306
DB_NAME=<NOME_DO_BANCO>
DB_USER=<USUARIO_DO_BANCO>
DB_PASSWORD=<DEFINIR_EM_AMBIENTE_SEGURO>
DB_ROOT_PASSWORD=<DEFINIR_EM_AMBIENTE_SEGURO>
FRAPPE_ADMIN_PASSWORD=<DEFINIR_EM_AMBIENTE_SEGURO>
GCP_DATABASE_BACKUP=backups/gcp-prod-database.sql.gz

# E-mail (Configuração SMTP do ERPNext)
SMTP_HOST=<SERVIDOR_SMTP>
SMTP_PORT=587
SMTP_USER=<USUARIO_SMTP>
SMTP_PASSWORD=<DEFINIR_EM_AMBIENTE_SEGURO>
SMTP_ENCRYPTION=starttls
SMTP_FROM_ADDRESS=<EMAIL_REMETENTE>
SMTP_FROM_NAME=CDC NextERP

# Mattermost (Alertas de monitoramento e backups)
MATTERMOST_ENABLED=false
MATTERMOST_WEBHOOK_URL=<MATTERMOST_WEBHOOK_URL>
MATTERMOST_CHANNEL=<MATTERMOST_CHANNEL>
MATTERMOST_USERNAME=InfraBot
MATTERMOST_ICON_URL=<URL_PUBLICA_DO_ICONE>
MATTERMOST_TIMEOUT_SECONDS=10

# Extrator de Dados (API Keys)
EXTRACTOR_API_KEY=<API_TOKEN>
EXTRACTOR_API_SECRET=<API_SECRET>
EXTERNAL_API_URL=<EXTERNAL_API_URL>
EXTERNAL_API_TOKEN=<EXTERNAL_API_TOKEN>
GPG_PASSPHRASE_FILE=.gpg_passphrase
